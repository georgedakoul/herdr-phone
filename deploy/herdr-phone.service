[Unit]
Description=herdr-phone, a phone view of the local Herdr session
Documentation=https://github.com/georgedakoul/herdr-phone
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/herdr-phone
EnvironmentFile=-%h/.config/herdr-phone/env
# A headless boot has no login-shell PATH, so nvm's node and the herdr binary
# in ~/.local/bin are invisible to `env` without this line.
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node %h/herdr-phone/src/index.js
# The app exits when Herdr is not running, so a retry every thirty seconds
# doubles as waiting for Herdr to come up.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
